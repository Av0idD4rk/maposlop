# Local defaults already work without this file. Production must set the
# variables below in the process environment; Django does not auto-load .env.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=ctf.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://ctf.example.org
DATABASE_URL=postgresql://ctf_user:replace-me@db:5432/ctf_map
CACHE_URL=redis://cache:6379/0
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_SECURE_HSTS_SECONDS=3600
# Enable only after every subdomain is HTTPS-ready.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
CTFMAP_SUBMISSION_MAX_BODY_BYTES=32768
CTFMAP_SUBMISSION_RATE_LIMIT=5
CTFMAP_SUBMISSION_RATE_WINDOW=3600
CTFMAP_GEOCODER_USER_AGENT=CTFMap/1.0 (+https://ctf.example.org/contact)
